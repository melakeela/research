{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file|mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-push-on-register-failure.sh",
            "timeout": 180,
            "statusMessage": "Validating registers before push"
          }
        ]
      }
    ]
  }
}
